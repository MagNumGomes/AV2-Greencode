generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum PapelUsuario {
  ADMINISTRADOR
  OPERADOR_CADASTRO
  GESTOR_ALMOXARIFADO
  AUDITOR
}

enum StatusLote {
  RECEBIDO
  EM_TRIAGEM
  TRIAGEM_CONCLUIDA
  ENCAMINHADO
  FINALIZADO
}

enum TipoEquipamento {
  COMPUTADOR_MESA
  NOTEBOOK
  MONITOR
  IMPRESSORA
  SERVIDOR
  ROTEADOR
  CABO_ESTRUTURADO
  FONTE_ALIMENTACAO
}

enum EstadoFisico {
  NOVO
  BOM_ESTADO
  USADO_LEVE
  USADO_MODERADO
  DANIFICADO_LEVE
  DANIFICADO_GRAVE
  INSERVIVEL
}

enum StatusRastreamento {
  AGUARDANDO_TRIAGEM
  EM_TRIAGEM
  AGUARDANDO_DESMONTE
  EM_DESMONTE
  PECAS_REAPROVEITADAS
  MATERIAL_RECICLAVEL
  DESCARTE_SEGURO
  BAIXA_DEFINITIVA
}

enum TipoMovimentacao {
  RECEBIMENTO
  STATUS
  ESTADO_FISICO
  LOCALIZACAO
}

model Usuario {
  id            String         @id @default(uuid()) @db.Uuid
  usuario       String         @unique @db.VarChar(60)
  hashSenha     String
  papel         PapelUsuario
  ativo         Boolean        @default(true)
  tokenVersao   Int            @default(1)
  versao        Int            @default(1)
  criadoEm      DateTime       @default(now()) @db.Timestamptz(3)
  atualizadoEm  DateTime       @updatedAt @db.Timestamptz(3)
  movimentacoes Movimentacao[]
  auditorias    Auditoria[]
}

model Organizacao {
  id                String    @id @default(uuid()) @db.Uuid
  razaoSocial       String    @db.VarChar(200)
  cnpj              String    @unique @db.VarChar(14)
  inscricaoEstadual String    @default("") @db.VarChar(30)
  enderecoCompleto  String    @db.VarChar(500)
  telefone          String    @db.VarChar(30)
  email             String    @db.VarChar(254)
  dataCadastro      DateTime  @default(now()) @db.Timestamptz(3)
  ativo             Boolean   @default(true)
  versao            Int       @default(1)
  contrato          Contrato?
  lotes             Lote[]
}

model Contrato {
  id                  String      @id @default(uuid()) @db.Uuid
  organizacaoId       String      @unique @db.Uuid
  dataAssinatura      DateTime    @db.Timestamptz(3)
  dataVencimento      DateTime    @db.Timestamptz(3)
  clausulas           Json
  valorMensal         Decimal     @db.Decimal(14, 2)
  renovacaoAutomatica Boolean     @default(false)
  versao              Int         @default(1)
  organizacao         Organizacao @relation(fields: [organizacaoId], references: [id], onDelete: Restrict)
}

model Lote {
  id                  String        @id @default(uuid()) @db.Uuid
  dataEntrada         DateTime      @db.Timestamptz(3)
  organizacaoId       String        @db.Uuid
  notaFiscal          String        @db.VarChar(100)
  transportadora      String        @db.VarChar(200)
  statusProcessamento StatusLote    @default(RECEBIDO)
  observacoes         String        @default("") @db.VarChar(2000)
  versao              Int           @default(1)
  organizacao         Organizacao   @relation(fields: [organizacaoId], references: [id], onDelete: Restrict)
  equipamentos        Equipamento[]

  @@index([organizacaoId, dataEntrada])
  @@index([statusProcessamento, dataEntrada])
}

model Equipamento {
  id                    String             @id @default(uuid()) @db.Uuid
  codigoBarrasInterno   String             @unique @db.VarChar(100)
  tipo                  TipoEquipamento
  marca                 String             @db.VarChar(100)
  modelo                String             @db.VarChar(100)
  anoFabricacao         Int
  estadoFisico          EstadoFisico
  pesoQuilogramas       Decimal            @db.Decimal(12, 3)
  loteId                String             @db.Uuid
  posicaoNoLote         Int
  statusRastreamento    StatusRastreamento @default(AGUARDANDO_TRIAGEM)
  localizacaoAtual      String             @default("Recebimento") @db.VarChar(200)
  versao                Int                @default(1)
  lote                  Lote               @relation(fields: [loteId], references: [id], onDelete: Restrict)
  historicoMovimentacao Movimentacao[]

  @@unique([loteId, posicaoNoLote])
  @@index([statusRastreamento])
}

model Movimentacao {
  id            String           @id @default(uuid()) @db.Uuid
  sequencia     Int              @unique @default(autoincrement())
  equipamentoId String           @db.Uuid
  dataHora      DateTime         @default(now()) @db.Timestamptz(3)
  tipo          TipoMovimentacao
  origem        String           @db.VarChar(200)
  destino       String           @db.VarChar(200)
  responsavelId String           @db.Uuid
  responsavel   String           @db.VarChar(60)
  observacao    String           @db.VarChar(2000)
  versao        Int              @default(1)
  equipamento   Equipamento      @relation(fields: [equipamentoId], references: [id], onDelete: Restrict)
  usuario       Usuario          @relation(fields: [responsavelId], references: [id], onDelete: Restrict)

  @@index([equipamentoId, dataHora])
}

model Auditoria {
  id                   String   @id @default(uuid()) @db.Uuid
  dataHora             DateTime @default(now()) @db.Timestamptz(3)
  operacao             String   @db.VarChar(80)
  entidade             String   @db.VarChar(40)
  entidadeId           String   @db.Uuid
  dadosAntes           Json?
  dadosDepois          Json
  usuarioResponsavelId String   @db.Uuid
  versao               Int      @default(1)
  usuario              Usuario  @relation(fields: [usuarioResponsavelId], references: [id], onDelete: Restrict)

  @@index([entidade, entidadeId, dataHora])
  @@index([dataHora])
}
